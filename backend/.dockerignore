# --- Version Control ---
.git
.gitignore

# --- Secrets & Config ---
.env
*.pem
*.key
docker-compose.yml
compose.yaml

# --- Python Backend Cleanup ---
**/__pycache__/
**/*.py[cod]
**/*.so
**/.venv/
**/env/
**/venv/
**/.pytest_cache/
**/.coverage
**/htmlcov/

# --- Runtime Model Caches ---
# compose.yaml points TORCH_HOME / HF_HOME / TRITON_CACHE_DIR into data/, which persists
# them through the ./backend mount; they must not be baked into the image (e.g. LPIPS's VGG16, ~530MB)
data/torch/
data/huggingface/
data/triton/

# --- Frontend (IMPORTANT) ---
# We ignore the entire frontend folder because the 
# backend container doesn't need to see it.
/frontend/

# --- IDE & OS Junk ---
.vscode/
.idea/
.DS_Store
Thumbs.db