{
  "name": "scatter",
  "description": "Scatter variant offspring across the parameter space",
  "category": "evolution",
  "execution": "queued",
  "initiator_types": ["individual", "group", "audio"],
  "context_overrides": {},
  "form_config": [
    {
      "name": "parents",
      "type": "node-list",
      "label": "Seed Individual(s)",
      "filter": {
        "type": "individual"
      },
      "required": true,
      "minItems": 1
    },
    {
      "name": "offspring_size",
      "type": "integer",
      "label": "Scatter Count (N)",
      "defaultValue": 10,
      "min": 1,
      "max": 100,
      "allowSequence": false
    },
    {
      "name": "noise_scale",
      "type": "float",
      "label": "Perturbation Scale (σ, relative to each weight tensor)",
      "defaultValue": 0.1,
      "min": 0.0,
      "max": 2.0,
      "step": 0.01,
      "allowSequence": false
    },
    {
      "name": "active_flips",
      "type": "float",
      "label": "Expected Active Flips per Offspring",
      "defaultValue": 1.0,
      "min": 0.0,
      "max": 20.0,
      "step": 0.5,
      "allowSequence": false
    },
    {
      "name": "generate_exemplars",
      "type": "boolean",
      "label": "Auto-Generate Exemplars",
      "defaultValue": true,
      "allowSequence": false
    }
  ]
}
