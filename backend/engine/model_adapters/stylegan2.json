{
    "import": [
        {
            "name": "name",
            "label": "Model Name",
            "type": "text",
            "defaultValue": "StyleGAN2",
            "placeholder": "Enter custom model name..."
        },
        {
            "name": "checkpoint_path",
            "label": "Checkpoint Path",
            "type": "file",
            "required": true,
            "filters": [
                { "name": "PyTorch Checkpoint", "extensions": ["pt", "pth", "pkl"] }
            ],
            "placeholder": "Select StyleGAN2 checkpoint file (.pt or .pkl)"
        }
    ],
    "generate": [
        {
            "name": "seed",
            "label": "Seed",
            "type": "integer",
            "defaultValue": 0,
            "placeholder": "Enter seed",
            "randomizable": true
        },
        {
            "name": "truncation",
            "label": "Truncation Value",
            "type": "float",
            "defaultValue": 0.7,
            "placeholder": "Between 0.0 and 1.0 (truncation trick)"
        },
        {
            "name": "randomize_noise",
            "label": "Randomize Noise",
            "type": "boolean",
            "defaultValue": false
        },
        {
            "name": "init_latent",
            "label": "Initial Latent",
            "type": "node",
            "filter": { "type": "latent" },
            "defaultValue": null
        }
    ],
    "invert": [
        {
            "name": "source_image",
            "label": "Source Image",
            "type": "node",
            "filter": { "type": "image" },
            "required": true
        },
        {
            "name": "projection_steps",
            "label": "Projection Steps",
            "type": "integer",
            "defaultValue": 500,
            "placeholder": "Steps optimizing the pivot latent"
        },
        {
            "name": "tuning_steps",
            "label": "Tuning Steps",
            "type": "integer",
            "defaultValue": 350,
            "placeholder": "Steps tuning the LoRA around the pivot"
        },
        {
            "name": "rank",
            "label": "LoRA Rank",
            "type": "integer",
            "defaultValue": 4,
            "placeholder": "Higher reconstructs more detail, stays less editable"
        },
        {
            "name": "projection_lr",
            "label": "Projection Learning Rate",
            "type": "float",
            "defaultValue": 0.1
        },
        {
            "name": "tuning_lr",
            "label": "Tuning Learning Rate",
            "type": "float",
            "defaultValue": 0.001
        },
        {
            "name": "use_lpips",
            "label": "Perceptual (LPIPS) Loss",
            "type": "boolean",
            "defaultValue": true
        },
        {
            "name": "seed",
            "label": "Seed",
            "type": "integer",
            "defaultValue": 0,
            "randomizable": true
        }
    ]
}
